<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package's manifest (docs/plans/store.md). @VERSION@ is filled in from Cargo.toml by
     build/msix.rs; Identity and PublisherDisplayName are the ones Partner Center reserved for busy. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <Identity
    Name="tmik.busysystemmonitor"
    Publisher="CN=4F8212EC-4D54-40AC-89B2-0BD561D3043C"
    Version="@VERSION@"
    ProcessorArchitecture="x64"/>
  <Properties>
    <DisplayName>busy — system monitor</DisplayName>
    <PublisherDisplayName>tmik</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <!-- Windows 11 23H2 and later, as busy supports (docs/testing.md). -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22631.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>
  <!-- The languages busy's UI has (busy_core::Lang), the default first; build/msix.rs writes the description in
       each. -->
  <Resources>
    <Resource Language="en-US"/>
    <Resource Language="de-DE"/>
    <Resource Language="es-ES"/>
    <Resource Language="fr-FR"/>
    <Resource Language="it-IT"/>
    <Resource Language="ja-JP"/>
    <Resource Language="ko-KR"/>
    <Resource Language="pl-PL"/>
    <Resource Language="pt-BR"/>
    <Resource Language="ru-RU"/>
    <Resource Language="zh-CN"/>
  </Resources>
  <Applications>
    <!-- A full-trust desktop app: its widget is a child window of explorer's taskbar. -->
    <Application Id="busy" Executable="busy.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="busy — system monitor"
        Description="ms-resource:AppDescription"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"/>
      <Extensions>
        <!-- Settings → Start with Windows (crates/settings/src/startup_task.rs, which names this TaskId). -->
        <desktop:Extension Category="windows.startupTask" Executable="busy.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="busy" Enabled="false" DisplayName="busy"/>
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
</Package>
